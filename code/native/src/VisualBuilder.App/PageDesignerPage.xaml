<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="VisualBuilder.App.PageDesignerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><MenuBar><MenuBarItem Title="File"><MenuFlyoutItem Text="Save" Click="Save_Click" KeyboardAcceleratorTextOverride="Ctrl+S" /><MenuFlyoutItem Text="Close project" Click="CloseProject_Click" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="Exit VisualBuilder" Click="ExitApplication_Click" /></MenuBarItem></MenuBar><CommandBar DefaultLabelPosition="Right"><AppBarButton Icon="Back" Label="Models" Click="Back_Click" /><AppBarSeparator /><AppBarButton Icon="Save" Label="Save" Click="Save_Click" /></CommandBar></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Project explorer" Style="{StaticResource SubtitleTextBlockStyle}" /><ScrollViewer Grid.Row="1" Margin="0,10,0,0"><StackPanel>
                <Expander Header="Models"><ListView x:Name="ExplorerModelsList" IsItemClickEnabled="True" ItemClick="ExplorerModelsList_ItemClick" SelectionMode="None" DisplayMemberPath="Name" /></Expander>
                <Expander Header="Pages" IsExpanded="True"><StackPanel><Button Content="+ Add page" HorizontalAlignment="Stretch" Click="AddPage_Click" /><ListView x:Name="PagesList" Margin="0,8" IsItemClickEnabled="True" ItemClick="PagesList_ItemClick"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="5"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Expander>
                <Expander Header="Functions"><StackPanel><Button Content="+ Add or manage functions" HorizontalAlignment="Stretch" Click="OpenFunctionDesigner_Click" /><ListView x:Name="ExplorerFunctionsList" IsItemClickEnabled="True" ItemClick="ExplorerFunctionsList_ItemClick" DisplayMemberPath="Name" /></StackPanel></Expander>
                <Expander Header="Config"><TextBlock Margin="12,6" Text="Project settings (next phase)" /></Expander><Expander Header="Iterations"><TextBlock Margin="12,6" Text="Current iteration" /></Expander>
            </StackPanel></ScrollViewer></Grid></Border>
            <Grid Grid.Column="1" Padding="28"><TextBlock x:Name="NoPageText" Text="Add or select a page to begin designing." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid x:Name="PageEditor" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock x:Name="PageNameText" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock x:Name="PageSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Edit page" Click="EditPage_Click" /><Button Content="Delete page" Click="DeletePage_Click" /></StackPanel></Grid>
                    <Grid Grid.Row="1" Margin="0,20,0,8"><TextBlock Text="Page content" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Add control" Style="{StaticResource AccentButtonStyle}"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Input" Tag="input" Click="AddTypedContent_Click" /><MenuFlyoutItem Text="Textarea" Tag="textarea" Click="AddTypedContent_Click" /><MenuFlyoutItem Text="Select" Tag="select" Click="AddTypedContent_Click" /><MenuFlyoutItem Text="Checkbox" Tag="checkbox" Click="AddTypedContent_Click" /><MenuFlyoutItem Text="Date" Tag="date" Click="AddTypedContent_Click" /><MenuFlyoutItem Text="Button" Tag="button" Click="AddTypedContent_Click" /></MenuFlyout></Button.Flyout></Button><Button Content="Add element"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Heading" Tag="heading" Click="AddTypedContent_Click" /><MenuFlyoutItem Text="Text" Tag="text" Click="AddTypedContent_Click" /><MenuFlyoutItem Text="Table" Tag="table" Click="AddTypedContent_Click" /><MenuFlyoutItem Text="Card" Tag="card" Click="AddTypedContent_Click" /></MenuFlyout></Button.Flyout></Button><Button x:Name="EditControlButton" Content="Edit" Click="EditControl_Click" IsEnabled="False" /><Button x:Name="DeleteControlButton" Content="Delete" Click="DeleteControl_Click" IsEnabled="False" /></StackPanel></Grid>
                    <ListView x:Name="ControlsList" Grid.Row="2" SelectionChanged="ControlsList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Control.Label}" FontWeight="SemiBold" /><TextBlock Text="{Binding Binding}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Control.Type}" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Control.Width}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                </Grid>
            </Grid>
            <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" Padding="16"><StackPanel Spacing="12"><TextBlock Text="Page properties" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Name="PagePropertiesText" Text="No page selected" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" /><TextBlock Text="Control order" FontWeight="SemiBold" /><Button x:Name="MoveUpButton" Content="Move selected up" Click="MoveControlUp_Click" IsEnabled="False" /><Button x:Name="MoveDownButton" Content="Move selected down" Click="MoveControlDown_Click" IsEnabled="False" /><TextBlock Text="Controls are generated in this order. Width controls their responsive layout in the generated page." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Padding="12,7" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="Ready" /></Border>
    </Grid>
</Page>

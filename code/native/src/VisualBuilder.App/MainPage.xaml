<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="VisualBuilder.App.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Padding="8,4">
            <AppBarButton Icon="Add" Label="New project" Click="NewProject_Click" /><AppBarButton Icon="OpenFile" Label="Open" Click="OpenProject_Click" /><AppBarSeparator />
            <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save" Click="SaveProject_Click" IsEnabled="False" /><AppBarButton Icon="Play" Label="Run" IsEnabled="False" /><AppBarButton Icon="Upload" Label="Package" IsEnabled="False" />
        </CommandBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,0" Padding="16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="10">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Project explorer" />
                        <Grid><TextBlock Text="Models" FontWeight="SemiBold" VerticalAlignment="Center" /><Button x:Name="AddModelButton" HorizontalAlignment="Right" Content="+ Add" Click="AddModel_Click" IsEnabled="False" /></Grid>
                    </StackPanel>
                    <ListView x:Name="ModelsList" Grid.Row="1" Margin="0,8" IsItemClickEnabled="True" ItemClick="ModelsList_ItemClick" SelectionMode="Single">
                        <ListView.ItemTemplate><DataTemplate><StackPanel Padding="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding TableName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="8"><TextBlock FontWeight="SemiBold" Text="Recent projects" /><ListView x:Name="RecentProjectsList" MaxHeight="180" IsItemClickEnabled="True" ItemClick="RecentProjects_ItemClick" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="4"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Padding="28">
                <StackPanel x:Name="EmptyState" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18"><FontIcon Glyph="&#xE943;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Build Laravel applications visually" TextAlignment="Center" /><TextBlock Text="Create a project to design pages, data models, relationships and block-based functions." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"><Button Content="New project" Click="NewProject_Click" Style="{StaticResource AccentButtonStyle}" Padding="22,10" /><Button Content="Open project" Click="OpenProject_Click" Padding="22,10" /></StackPanel></StackPanel>
                <Grid x:Name="ProjectState" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="ProjectNameText" Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock x:Name="ProjectSummaryText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <InfoBar x:Name="NoModelInfo" Grid.Row="2" IsOpen="True" IsClosable="False" Severity="Informational" Message="Add your first model from the Project explorer." />
                    <Grid x:Name="ModelEditor" Grid.Row="3" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><StackPanel><TextBlock x:Name="ModelNameText" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Name="ModelTableText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Edit model" Click="EditModel_Click" /><Button Content="Delete model" Click="DeleteModel_Click" /></StackPanel></Grid>
                        <Grid Grid.Row="1" Margin="0,20,0,8"><TextBlock Text="Fields" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Add field" Click="AddField_Click" Style="{StaticResource AccentButtonStyle}" /><Button x:Name="EditFieldButton" Content="Edit" Click="EditField_Click" IsEnabled="False" /><Button x:Name="DeleteFieldButton" Content="Delete" Click="DeleteField_Click" IsEnabled="False" /></StackPanel></Grid>
                        <ListView x:Name="FieldsList" Grid.Row="2" SelectionChanged="FieldsList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Padding="8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /><TextBlock Text="{Binding Name}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Type}" VerticalAlignment="Center" /><StackPanel Grid.Column="2" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal"><TextBlock Text="Nullable: " /><TextBlock Text="{Binding Nullable}" /></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Indexed: " /><TextBlock Text="{Binding Indexed}" /></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Unique: " /><TextBlock Text="{Binding Unique}" /></StackPanel></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" Padding="16">
                <StackPanel Spacing="14"><TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Model properties" /><TextBlock x:Name="ModelOptionsText" Text="Select a model" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" /><Grid><TextBlock Text="Relationships" FontWeight="SemiBold" /><Button x:Name="AddRelationshipButton" HorizontalAlignment="Right" Content="+ Add" Click="AddRelationship_Click" IsEnabled="False" /></Grid><ListView x:Name="RelationshipsList" SelectionChanged="RelationshipsList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="5"><TextBlock Text="{Binding Relationship.Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><Button x:Name="DeleteRelationshipButton" Content="Delete selected relationship" Click="DeleteRelationship_Click" IsEnabled="False" /></StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Padding="12,7" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><Grid><TextBlock x:Name="StatusText" Text="Ready" /><TextBlock HorizontalAlignment="Right" Text="Autosave: on • Project format 1.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></Border>
    </Grid>
</Page>

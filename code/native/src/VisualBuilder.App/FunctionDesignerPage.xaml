<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="VisualBuilder.App.FunctionDesignerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><MenuBar><MenuBarItem Title="File"><MenuFlyoutItem Text="Save" Click="Save_Click" /><MenuFlyoutItem Text="Close project" Click="CloseProject_Click" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="Exit VisualBuilder" Click="ExitApplication_Click" /></MenuBarItem></MenuBar><CommandBar DefaultLabelPosition="Right"><AppBarButton Icon="Back" Label="Models" Click="Models_Click" /><AppBarButton Icon="Page" Label="Pages" Click="Pages_Click" /><AppBarSeparator /><AppBarButton Icon="Save" Label="Save" Click="Save_Click" /></CommandBar></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="*" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Project explorer" Style="{StaticResource SubtitleTextBlockStyle}" /><ScrollViewer Grid.Row="1" Margin="0,10,0,0"><StackPanel><Expander Header="Models"><ListView x:Name="ExplorerModelsList" IsItemClickEnabled="True" ItemClick="ExplorerModelsList_ItemClick" DisplayMemberPath="Name" /></Expander><Expander Header="Pages"><ListView x:Name="ExplorerPagesList" IsItemClickEnabled="True" ItemClick="ExplorerPagesList_ItemClick" DisplayMemberPath="Name" /></Expander><Expander Header="Functions" IsExpanded="True"><StackPanel><Button Content="+ Add function" Click="AddFunction_Click" HorizontalAlignment="Stretch" /><ListView x:Name="FunctionsList" IsItemClickEnabled="True" ItemClick="FunctionsList_ItemClick"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Scope}" FontSize="11" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Expander><Expander Header="Config"><TextBlock Margin="12,6" Text="Project settings (next phase)" /></Expander><Expander Header="Iterations"><TextBlock Margin="12,6" Text="Current iteration" /></Expander></StackPanel></ScrollViewer></Grid></Border>
            <Grid Grid.Column="1" Padding="28"><TextBlock x:Name="NoFunctionText" Text="Add or select a function to build its flow." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Grid x:Name="FunctionEditor" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><StackPanel><TextBlock x:Name="FunctionNameText" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock x:Name="FunctionSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Edit function" Click="EditFunction_Click" /><Button Content="Delete function" Click="DeleteFunction_Click" /></StackPanel></Grid><Grid Grid.Row="1" Margin="0,20,0,8"><TextBlock Text="Function flow" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Add block" Style="{StaticResource AccentButtonStyle}"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Validate" Tag="Validate" Click="AddBlock_Click" /><MenuFlyoutItem Text="Authorize" Tag="Authorize" Click="AddBlock_Click" /><MenuFlyoutItem Text="Query records" Tag="Query" Click="AddBlock_Click" /><MenuFlyoutItem Text="Create record" Tag="CreateRecord" Click="AddBlock_Click" /><MenuFlyoutItem Text="Update record" Tag="UpdateRecord" Click="AddBlock_Click" /><MenuFlyoutItem Text="Delete record" Tag="DeleteRecord" Click="AddBlock_Click" /><MenuFlyoutItem Text="Condition" Tag="Condition" Click="AddBlock_Click" /><MenuFlyoutItem Text="Set value" Tag="SetValue" Click="AddBlock_Click" /><MenuFlyoutItem Text="Notify" Tag="Notify" Click="AddBlock_Click" /><MenuFlyoutItem Text="Navigate" Tag="Navigate" Click="AddBlock_Click" /><MenuFlyoutItem Text="Send email" Tag="SendEmail" Click="AddBlock_Click" /></MenuFlyout></Button.Flyout></Button><Button x:Name="EditBlockButton" Content="Configure" Click="EditBlock_Click" IsEnabled="False" /><Button x:Name="DeleteBlockButton" Content="Delete" Click="DeleteBlock_Click" IsEnabled="False" /></StackPanel></Grid><ListView x:Name="BlocksList" Grid.Row="2" SelectionChanged="BlocksList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Border Margin="0,4" Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Configuration}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></Grid></Grid>
            <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" Padding="16"><StackPanel Spacing="12"><TextBlock Text="Function properties" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock x:Name="FunctionPropertiesText" Text="No function selected" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button x:Name="BindEventButton" Content="Bind page/control event" Click="BindEvent_Click" IsEnabled="False" /><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" /><TextBlock Text="Validation" FontWeight="SemiBold" /><InfoBar x:Name="ValidationInfo" IsOpen="False" IsClosable="False" /><ListView x:Name="ValidationIssuesList"><ListView.ItemTemplate><DataTemplate><TextBlock Padding="4" Text="{Binding Message}" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Padding="12,7" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="Ready" /></Border>
    </Grid>
</Page>

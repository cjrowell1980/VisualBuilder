<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="VisualBuilder.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Padding="8,4">
            <AppBarButton Icon="Add" Label="New project" Click="NewProject_Click" />
            <AppBarButton Icon="OpenFile" Label="Open" Click="OpenProject_Click" />
            <AppBarSeparator />
            <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save" Click="SaveProject_Click" IsEnabled="False" />
            <AppBarButton Icon="Play" Label="Run" IsEnabled="False" />
            <AppBarButton Icon="Upload" Label="Package" IsEnabled="False" />
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,0" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Project explorer" />
                    <TreeView IsEnabled="False"><TreeView.RootNodes><TreeViewNode Content="Pages" /><TreeViewNode Content="Models" /><TreeViewNode Content="Functions" /><TreeViewNode Content="Iterations" /></TreeView.RootNodes></TreeView>
                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Recent projects" />
                    <ListView x:Name="RecentProjectsList" IsItemClickEnabled="True" ItemClick="RecentProjects_ItemClick" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate><StackPanel Padding="4"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Padding="32">
                <StackPanel x:Name="EmptyState" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                    <FontIcon Glyph="&#xE943;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Build Laravel applications visually" TextAlignment="Center" />
                    <TextBlock Text="Create a project to design pages, data models, relationships and block-based functions in a native Windows workspace." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"><Button Content="New project" Click="NewProject_Click" Style="{StaticResource AccentButtonStyle}" Padding="22,10" /><Button Content="Open project" Click="OpenProject_Click" Padding="22,10" /></StackPanel>
                </StackPanel>
                <StackPanel x:Name="ProjectState" Visibility="Collapsed" Spacing="18">
                    <TextBlock x:Name="ProjectNameText" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="ProjectSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10"><TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Initial iteration" /><TextBlock Text="Your project file is ready. Page, model and function editors will be added in the next phases." TextWrapping="Wrap" /></StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" Padding="16">
                <StackPanel Spacing="14"><TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Properties" /><TextBlock Text="Nothing selected" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" /><TextBlock Text="Block toolbox" FontWeight="SemiBold" /><Button Content="Event" HorizontalAlignment="Stretch" IsEnabled="False" /><Button Content="Validate" HorizontalAlignment="Stretch" IsEnabled="False" /><Button Content="Authorize" HorizontalAlignment="Stretch" IsEnabled="False" /><Button Content="Condition" HorizontalAlignment="Stretch" IsEnabled="False" /><Button Content="Create / update record" HorizontalAlignment="Stretch" IsEnabled="False" /></StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Padding="12,7" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><Grid><TextBlock x:Name="StatusText" Text="Ready" /><TextBlock HorizontalAlignment="Right" Text="Autosave: on • Project format 1.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="VisualBuilder.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Padding="8,4">
            <AppBarButton Icon="Add" Label="New project" /><AppBarButton Icon="OpenFile" Label="Open" /><AppBarSeparator />
            <AppBarButton Icon="Save" Label="Save" IsEnabled="False" /><AppBarButton Icon="Play" Label="Run" IsEnabled="False" /><AppBarButton Icon="Upload" Label="Package" IsEnabled="False" />
        </CommandBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,0" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Project explorer" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="Create or open a VisualBuilder project." />
                    <TreeView IsEnabled="False"><TreeView.RootNodes><TreeViewNode Content="Pages" /><TreeViewNode Content="Models" /><TreeViewNode Content="Functions" /><TreeViewNode Content="Iterations" /></TreeView.RootNodes></TreeView>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" Padding="32">
                <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="18">
                    <FontIcon Glyph="&#xE943;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Build Laravel applications visually" TextAlignment="Center" />
                    <TextBlock Text="Design pages, data models, relationships and block-based functions in a native Windows workspace. VisualBuilder will generate readable Laravel, Livewire, Flux and Tailwind code." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"><Button Content="New project" Style="{StaticResource AccentButtonStyle}" Padding="22,10" /><Button Content="Open project" Padding="22,10" /></StackPanel>
                    <Border Margin="0,14,0,0" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="10"><TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Phase 0 native foundation" /><TextBlock Text="✓ Versioned project contract" /><TextBlock Text="✓ Typed page and model definitions" /><TextBlock Text="✓ Safe function-graph validation" /><TextBlock Text="Next: project creation and persistence" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" Padding="16">
                <StackPanel Spacing="14"><TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Properties" /><TextBlock Text="Nothing selected" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" /><TextBlock Text="Block toolbox" FontWeight="SemiBold" /><Button Content="Event" HorizontalAlignment="Stretch" IsEnabled="False" /><Button Content="Validate" HorizontalAlignment="Stretch" IsEnabled="False" /><Button Content="Authorize" HorizontalAlignment="Stretch" IsEnabled="False" /><Button Content="Condition" HorizontalAlignment="Stretch" IsEnabled="False" /><Button Content="Create / update record" HorizontalAlignment="Stretch" IsEnabled="False" /></StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Padding="12,7" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><Grid><TextBlock Text="Ready" /><TextBlock HorizontalAlignment="Right" Text="Native preview • Project format 1.0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid></Border>
    </Grid>
</Page>
